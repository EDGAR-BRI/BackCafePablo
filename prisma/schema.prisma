generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// nivel 1

model Rol {
  id      Int       @id @default(autoincrement())
  nombre  String    @unique @map("name")
  estado  Boolean   @default(true) @map("status")
  usuarios Usuario[]

  @@map("roles")
}

model Categoria {
  id        Int       @id @default(autoincrement())
  nombre    String    @unique @map("name")
  estado    Boolean   @default(true) @map("status")
  productos Producto[]

  @@map("categories")
}

model Mesa {
  id        Int       @id @default(autoincrement())
  nombre    String    @unique @map("name") // ej. "Mesa 1 (Terraza)"
  capacidad Int       @default(4) @map("capacity")
  estado    Boolean   @default(true) @map("status") // true = disponible
  ordenes   Orden[]

  @@map("mesas")
}

// nivel 2

model Usuario {
  id       Int     @id @default(autoincrement())
  nombre   String  @map("name")
  email    String  @unique @map("email")
  password String  @map("password")
  rol_id   Int     @map("role_id")
  estado   Boolean @default(true) @map("status")
  
  rol     Rol     @relation(fields: [rol_id], references: [id])
  ordenes Orden[]
  
  @@map("users")
}

model Producto {
  id           Int     @id @default(autoincrement())
  nombre       String  @map("name")
  precio       Float   @map("price")
  cantidad     Int     @default(0) @map("quantity")
  categoria_id Int     @map("category_id")
  estado       Boolean @default(true) @map("status")
  
  categoria   Categoria      @relation(fields: [categoria_id], references: [id])
  detalles    DetalleOrden[]
  
  @@map("products")
}

// nivel 3: Ordenes y transacciones

model Orden {
  id         Int      @id @default(autoincrement())
  mesa_id    Int
  usuario_id Int      // El mesero que tomó la orden
  estado     String   @default("pendiente") // pendiente, pagada, cancelada
  total      Float    @default(0)
  notas      String?  // Instrucciones especiales
  creado_en  DateTime @default(now())
  actualizado_en DateTime @updatedAt

  mesa      Mesa           @relation(fields: [mesa_id], references: [id])
  usuario   Usuario        @relation(fields: [usuario_id], references: [id])
  detalles  DetalleOrden[]
  pagos     Pago[]

  @@map("ordenes")
}

model DetalleOrden {
  id          Int     @id @default(autoincrement())
  orden_id    Int
  producto_id Int
  cantidad    Int
  precio      Float   // Precio en el momento de la orden
  notas       String?

  orden    Orden    @relation(fields: [orden_id], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [producto_id], references: [id])

  @@map("detalles_orden")
}

model Pago {
  id               Int      @id @default(autoincrement())
  orden_id         Int
  metodo           String   // ej: 'efectivo', 'punto', 'pago_movil'
  monto_entregado  Float
  total            Float
  cambio           Float    @default(0)
  referencia       String?  // para pagos con tarjeta/móvil
  split_id         String?  // para agrupar pagos de una misma orden
  creado_en        DateTime @default(now())

  orden Orden @relation(fields: [orden_id], references: [id], onDelete: Cascade)

  @@map("pagos")
}

// ============ CONTABILIDAD ============

model CuentaContable {
  id          Int     @id @default(autoincrement())
  codigo      String  @unique // ej: "1.01.01"
  nombre      String
  tipo        String  // A (Activo), P (Pasivo), Pat (Patrimonio), I (Ingreso), C (Costo), G (Gasto)
  naturaleza  String  // deudora, acredora

  detalles    DetalleAsiento[]

  @@map("cuentas_contables")
}

model Asiento {
  id          Int      @id @default(autoincrement())
  fecha       DateTime @default(now())
  concepto    String
  origen      String   // orden_pago, gasto, cierre_caja, etc.
  origen_id   String?  // ID del registro origen (ej: orden_id)

  detalles    DetalleAsiento[]

  @@map("asientos")
}

model DetalleAsiento {
  id          Int     @id @default(autoincrement())
  asiento_id  Int
  cuenta_id   Int
  debe        Float   @default(0)
  haber       Float   @default(0)

  asiento     Asiento       @relation(fields: [asiento_id], references: [id], onDelete: Cascade)
  cuenta      CuentaContable @relation(fields: [cuenta_id], references: [id])

  @@map("detalles_asiento")
}

model Caja {
  id          Int      @id @default(autoincrement())
  fecha       DateTime @default(now())
  tipo        String   // ingreso, egreso
  monto       Float
  concepto    String
  saldo       Float    // saldo después de esta operación
  origen      String   // orden_pago, gasto, cierre_caja
  origen_id   String?

  @@map("cajas")
}
